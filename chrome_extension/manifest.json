{
  "manifest_version": 3,
  "name": "AI Vastra — WhatsApp Web CRM Overlay",
  "version": "1.0.0",
  "description": "Powerful CRM Lead Drawer, Auto-Responder & AI Smart Reply Suggestions directly inside official WhatsApp Web.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Vastra CRM Overlay"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
