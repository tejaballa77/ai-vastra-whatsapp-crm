{
  "manifest_version": 3,
  "name": "AI Vastra - WhatsApp Web CRM Extension",
  "version": "1.0.0",
  "description": "Directly integrates AI Vastra CRM workspace into WhatsApp Web (web.whatsapp.com) with live Lead Status, Call tracking, Follow-up scheduler, and CRM Notes.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://crm.nicedigitalsgroup.com/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Vastra CRM Extension Settings"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "styles.css"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ]
}
